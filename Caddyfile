{
    auto_https off
}

localhost:80 {
    reverse_proxy frontend:3000

    header {
        -Server
        Strict-Transport-Security "max-age=63072000"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    encode gzip
}