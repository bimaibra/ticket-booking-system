# Environment Configuration
# Copy this file to .env and fill in real values.

# Database (PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DB_NAME?schema=public"

# JWT Secrets (use strong random strings in production; rotate periodically)
# To rotate: set new value as primary, move old value to FALLBACKS (comma-separated).
# Tokens signed with any fallback key remain valid until they expire.
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars-long"
JWT_ACCESS_SECRET_FALLBACKS=""
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars-long"
JWT_REFRESH_SECRET_FALLBACKS=""

# Token lifetimes (seconds)
JWT_ACCESS_EXPIRY="900"
JWT_REFRESH_EXPIRY="604800"

# Hold & Idempotency TTLs (seconds)
HOLD_TTL_SECONDS="600"
IDEMPOTENCY_TTL_SECONDS="86400"

# Server
PORT="3001"
NODE_ENV="development"

# CORS (comma-separated origins; "*" is not allowed in production)
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

# Rate Limiting (global + auth endpoints)
RATE_LIMIT_WINDOW_MS="900000"
RATE_LIMIT_MAX_REQUESTS="100"
AUTH_RATE_LIMIT_MAX="5"

# Bcrypt
BCRYPT_ROUNDS="12"

# Logging
LOG_LEVEL="info"
